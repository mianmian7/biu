{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Biu",
  "version": "2.0.7",
  "identifier": "com.biu.wood3n",
  "build": {
    "frontendDist": "../dist/web",
    "devUrl": "http://localhost:5678",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Biu",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-libav",
          "gstreamer1.0-plugins-good",
          "libwebkit2gtk-4.1-0"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "Biu Self-Signed Code Signing"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mianmian7/biu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGMzA4MkVDNkQyN0EzQTAKUldTZ295ZHQ3SUl3cndwamp2cU96cEE1UWJJR2tPREtVTkt1T2k0Z2IwWk04bzYwSGlKei92Y08K"
    }
  }
}
